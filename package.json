{
  "name": "lipahub",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "npm run dev --workspace frontend --",
    "dev:frontend": "npm run dev --workspace frontend --",
    "dev:api": "npm run dev --workspace Backend",
    "dev:backend": "npm run dev --workspace Backend",
    "build": "tsc -p tsconfig.json && npm run build --workspaces --if-present",
    "lint": "eslint .",
    "preview": "npm run preview --workspace frontend --",
    "start:api": "npm run start --workspace Backend",
    "setup:check": "node Backend/scripts/check-setup.mjs",
    "test": "npm run build --workspace Backend && playwright test",
    "test:db": "node --test Backend/tests/*.test.mjs",
    "check": "npm run lint && npm run build && npm run test:db && npm test && npm run test:activation",
    "backend:check": "node Backend/scripts/check-backend.mjs",
    "setup:sql": "node Backend/scripts/build-setup.mjs",
    "test:activation": "playwright test --config playwright.activation.config.ts"
  },
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^11.0.1"
    }
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "@eslint/js": "^9.36.0",
    "@playwright/test": "^1.55.1",
    "@tailwindcss/vite": "^4.1.13",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/node": "^24.5.2",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.3",
    "eslint": "^9.36.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.4.0",
    "tailwindcss": "^4.1.13",
    "tsx": "^4.20.5",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.44.0",
    "vite": "^7.1.7"
  },
  "workspaces": [
    "frontend",
    "Backend"
  ],
  "engines": {
    "node": "24.x"
  }
}
