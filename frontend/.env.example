VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Canonical public origin used for SEO tags, robots.txt and sitemap.xml.
# Defaults to https://lipahub1.vercel.app until the final domain is connected.
VITE_SITE_URL=https://lipahub1.vercel.app
# Leave empty for a combined frontend/API Vercel deployment.
# Local development defaults to http://127.0.0.1:3001.
VITE_API_URL=
# Defaults to enabled during local development and disabled in production builds.
# Set false here when preparing a real-account environment.
VITE_ENABLE_DEMO=false
