SUPABASE_URL=
SUPABASE_ANON_KEY=
WEB_ORIGIN=http://127.0.0.1:5173
PORT=3001
# Use 0.0.0.0 on a container host; keep loopback for local development.
HOST=127.0.0.1
# Server-only credential for user administration, private storage and database RPCs.
SUPABASE_SERVICE_ROLE_KEY=
# Keep false until the database/storage migration and integration review are complete.
PAYMENT_PROOF_INTAKE_ENABLED=false

# Number of known reverse-proxy hops. Keep 0 for direct/local connections.
TRUST_PROXY_HOPS=0
# Timeout for each Supabase Auth, database or storage HTTP request.
UPSTREAM_TIMEOUT_MS=10000
